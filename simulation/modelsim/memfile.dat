E04F000F // 0x00: SUB R0, R15, R15        -> R0 = 0
E2801005 // 0x04: ADD R1, R0, #5          -> R1 = 0 + 5 = 5
E2812003 // 0x08: ADD R2, R1, #3          -> R2 = 5 + 3 = 8
E0423001 // 0x0C: SUB R3, R2, R1          -> R3 = 8 - 5 = 3
E0024001 // 0x10: AND R4, R2, R1          -> R4 = 8 & 5 = 0
E1825001 // 0x14: ORR R5, R2, R1          -> R5 = 8 | 5 = 13 (0xD)
E0806081 // 0x18: ADD R6, R0, R1, LSL #1  -> R6 = 0 + (5 << 1) = 10 (0xA)
E5806050 // 0x1C: STR R6, [R0, #80]       -> mem[80] (0x50) = 10
E5907050 // 0x20: LDR R7, [R0, #80]       -> R7 = mem[80] = 10
E1570006 // 0x24: CMP R7, R6              -> 10 - 10 = 0 (bật cờ Z = 1)
0A000000 // 0x28: BEQ 0x30                -> Z = 1 nên nhảy tới (0x28 + 8) + 0 = 0x30 (bỏ qua 0x2C)
E2808001 // 0x2C: ADD R8, R0, #1          -> Bị bỏ qua nếu lệnh BEQ nhảy đúng
E2808005 // 0x30: ADD R8, R0, #5          -> R8 = 0 + 5 = 5
E5808054 // 0x34: STR R8, [R0, #84]       -> mem[84] (0x54) = 5 (mốc báo mô phỏng chạy đúng)
EAFFFFFE // 0x38: B 0x38                  -> Nhảy về (0x38 + 8) - 8 = 0x38 (vòng lặp dừng chương trình)